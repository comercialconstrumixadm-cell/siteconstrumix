# Copie para .env.local e preencha antes de rodar o app.

# --- Senha do módulo Gestão (protegido) ---
# Senha em texto simples usada para o login do módulo Gestão.
# Trocar por hash + usuários reais se precisar de mais de um gestor no futuro.
GESTAO_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# --- Banco de dados próprio da aplicação (SQLite) ---
# Caminho do arquivo .sqlite (histórico de orçamentos, índice de produtos,
# vendedores ativos por mês e histórico de bonificação calculada).
APP_DB_PATH=./data/app.sqlite

# --- Bancos Firebird do Zeus (3 empresas, mesma máquina, .fdb diferentes) ---
# PENDENTE: Marcos precisa fornecer IP/porta/caminho/usuário/senha reais de
# cada um. Sem isso os conectores em lib/firebird ficam em modo stub.
FIREBIRD_CONSTRUMIX_HOST=
FIREBIRD_CONSTRUMIX_PORT=3050
FIREBIRD_CONSTRUMIX_DATABASE=
FIREBIRD_CONSTRUMIX_USER=SYSDBA
FIREBIRD_CONSTRUMIX_PASSWORD=

FIREBIRD_SAMS_HOST=
FIREBIRD_SAMS_PORT=3050
FIREBIRD_SAMS_DATABASE=
FIREBIRD_SAMS_USER=SYSDBA
FIREBIRD_SAMS_PASSWORD=

FIREBIRD_NEWHOUSE_HOST=
FIREBIRD_NEWHOUSE_PORT=3050
FIREBIRD_NEWHOUSE_DATABASE=
FIREBIRD_NEWHOUSE_USER=SYSDBA
FIREBIRD_NEWHOUSE_PASSWORD=

# PENDENTE: nome exato da tabela/view do relatório "faturamento de pedidos"
# no banco da Construmix (diferente do faturamento por NF). Ver
# lib/firebird/construmixFaturamento.ts.
FIREBIRD_CONSTRUMIX_FATURAMENTO_PEDIDOS_QUERY=

# PENDENTE: como isolar vendas de cimento (categoria, CEST, código de
# produto etc). Ver lib/firebird/cimentoFilter.ts.
FIREBIRD_CONSTRUMIX_CIMENTO_FILTRO=
