# Copie para .env.local e preencha antes de rodar o app.

# --- Senha do módulo Gestão (protegido) ---
# Senha em texto simples usada para o login do módulo Gestão.
# Trocar por hash + usuários reais se precisar de mais de um gestor no futuro.
GESTAO_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# --- Banco de dados próprio da aplicação (SQLite) ---
# Caminho do arquivo .sqlite (histórico de orçamentos, índice de produtos,
# vendedores ativos por mês e histórico de bonificação calculada).
APP_DB_PATH=./data/app.sqlite

# --- Bancos PostgreSQL do Zeus (3 empresas, mesmo servidor, bancos diferentes) ---
# Confirmado por inspeção direta do schema em 2026-08: um único servidor
# PostgreSQL 9.5, porta 5432, com um usuário de consulta dedicado
# ("usuario_consulta") já criado pelo suporte do Zeus — mais seguro que usar
# o usuário "postgres". Os nomes de banco abaixo já são os reais
# (base_construmix / base_samscomercio / base_newhouse) e não costumam
# precisar ser alterados.
#
# Este app roda dentro da própria loja, na mesma rede local do Postgres —
# então o HOST aqui deve ser o IP local desse servidor (ex: 192.168.x.x),
# não `127.0.0.1` (só funciona rodando na própria máquina do Postgres) nem
# um endereço exposto à internet (não precisa e não é recomendado). Sem
# preencher, os conectores em lib/postgres ficam em modo stub.
POSTGRES_CONSTRUMIX_HOST=
POSTGRES_CONSTRUMIX_PORT=5432
POSTGRES_CONSTRUMIX_DATABASE=base_construmix
POSTGRES_CONSTRUMIX_USER=usuario_consulta
POSTGRES_CONSTRUMIX_PASSWORD=

POSTGRES_SAMS_HOST=
POSTGRES_SAMS_PORT=5432
POSTGRES_SAMS_DATABASE=base_samscomercio
POSTGRES_SAMS_USER=usuario_consulta
POSTGRES_SAMS_PASSWORD=

POSTGRES_NEWHOUSE_HOST=
POSTGRES_NEWHOUSE_PORT=5432
POSTGRES_NEWHOUSE_DATABASE=base_newhouse
POSTGRES_NEWHOUSE_USER=usuario_consulta
POSTGRES_NEWHOUSE_PASSWORD=

# "Faturamento de pedidos" e "vendas de cimento" já têm queries reais
# escritas (ver lib/postgres/construmixFaturamento.ts e cimentoFilter.ts,
# baseadas nas tabelas prevendas / prevendas_faturamento / prevendasprod /
# produtos) — não precisam mais de configuração aqui. Só falta validar os
# números contra a planilha de referência (cancelamentos/devoluções ainda
# não são excluídos).
